{
	"name": "supabase-storage-upload-action",
	"version": "1.0.4",
	"description": "GitHub Action for uploading files to Supabase Storage.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24.12.0 <25"
	},
	"scripts": {
		"prepare": "husky",
		"changeset": "changeset",
		"version": "changeset version",
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc --project tsconfig.build.json && rollup --config rollup.config.mjs",
		"verify": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@changesets/cli": "2.31.1",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/types": "21.2.0",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-json": "6.1.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@types/mime-types": "3.0.1",
		"@types/node": "26.2.0",
		"husky": "9.1.7",
		"rollup": "4.62.4",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/glob": "0.7.0",
		"@supabase/supabase-js": "2.111.0",
		"mime-types": "3.0.2",
		"tus-js-client": "4.3.1",
		"yaml": "2.9.0",
		"zod": "^4.4.3"
	}
}
