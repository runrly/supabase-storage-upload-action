{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"types": ["node"],
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": true,
		"outDir": "dist"
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
